# Copy to .env (git-ignored). Public client configuration only.
# Provider secrets NEVER go here — see docs/credentials.md.

# Supabase project (public values)
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=replace-with-anon-key

# Development identity. currentUser() returns this id when no session exists.
# Must match supabase/seed.sql.
VITE_DEV_USER_ID=00000000-0000-4000-8000-000000000001
VITE_DEV_USER_EMAIL=dev@vixera.local

# Praxion local connector (loopback only)
VITE_PRAXION_BASE_URL=http://127.0.0.1:47815
