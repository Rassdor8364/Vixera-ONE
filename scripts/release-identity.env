# The identities every release must carry. Public information — the signing
# keys themselves are in .signing/ and gen/android/, never committed.
#
# release-verify compares each artifact against these. A mismatch means the
# installer was signed with a different key than the installed app expects:
# on Android that is INSTALL_FAILED_UPDATE_INCOMPATIBLE for every user, so it
# must never ship by accident. Change these only when deliberately rotating a
# key, and update docs/installers.md in the same commit.
WINDOWS_SIGNER_SUBJECT="/CN=Vixera AI/O=Vixera AI/OU=Vixera One"
ANDROID_APPLICATION_ID=ai.vixera.one
ANDROID_SIGNER_SHA256=c3d0a85006a7b8c6f50980880d3ada4a3d3e1063298d0451a7ca90539af1c634
