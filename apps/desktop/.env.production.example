# Copy to .env.production before building installers (that file is git-ignored).
# The anon key is a PUBLIC client key: it identifies the project and carries no
# privileges. RLS protects the data. Never put the service role key here.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon key from supabase status / dashboard>
VITE_PRAXION_BASE_URL=http://127.0.0.1:47815
